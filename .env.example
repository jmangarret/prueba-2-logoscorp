# URLs OAuth/CRM de Zoho (valores públicos del centro de datos confirmado)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com

# Las credenciales quedan vacías. Complétalas solo en un archivo local ignorado;
# no publiques valores reales ni los expongas al código del navegador.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Token de acceso generado manualmente, usado solo por el servidor local.
ZOHO_ACCESS_TOKEN=
