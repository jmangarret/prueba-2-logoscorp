  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others \"vite --host 127.0.0.1\" \"node --env-file-if-exists=.env.local --import tsx --watch server/index.ts\"",
